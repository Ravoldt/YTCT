{
  "manifest_version": 3,
  "name": "YouTube Comment Toolkit",
  "version": "4.3.1",
  "description": "Read, search, export, and ask local or cloud LLMs about YouTube comments in the Chrome side panel.",
  "minimum_chrome_version": "142",
  "incognito": "not_allowed",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "alarms", "offscreen", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://yt3.ggpht.com/*",
    "https://yt3.googleusercontent.com/*"
  ],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*", "https://*/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "YouTube Comment Toolkit" },
  "web_accessible_resources": [
    { "resources": ["icons/comments.svg"], "matches": ["https://www.youtube.com/*"] }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["common.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
