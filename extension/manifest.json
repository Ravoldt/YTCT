{
  "manifest_version": 3,
  "name": "YouTube Comment Toolkit",
  "version": "4.3.0",
  "description": "Read, search, export, and ask local or cloud LLMs about YouTube comments in the Chrome side panel.",
  "minimum_chrome_version": "142",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "alarms", "offscreen"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://i.ytimg.com/*",
    "https://yt3.ggpht.com/*",
    "https://yt3.googleusercontent.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://api.mistral.ai/*",
    "https://api.x.ai/*",
    "https://api.together.xyz/*",
    "https://api.fireworks.ai/*",
    "https://api.cerebras.ai/*",
    "https://api.sambanova.ai/*",
    "https://api.tokenfactory.nebius.com/*",
    "https://api.perplexity.ai/*",
    "https://api.moonshot.ai/*",
    "https://api.z.ai/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "YouTube Comment Toolkit" },
  "web_accessible_resources": [
    { "resources": ["icons/comments.svg"], "matches": ["https://www.youtube.com/*"] }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["common.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["loopback-frame.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
